{
  "manifest_version": 3,
  "name": "X Guard",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "按地区、连接来源、粉丝数和多条明确辱骂筛选回复作者，支持本地审计、折叠、自动屏蔽和撤销。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Guard",
    "default_popup": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "core.js",
        "dom.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
